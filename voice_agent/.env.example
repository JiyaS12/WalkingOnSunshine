# Standalone desktop demo only; integrated calls use main patient/call IDs.
PATIENT_CODE=RGN-0417
PATIENT_REPOSITORY=in_memory
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Phone survey on 8001 (main:8000, frontend:3000).
# Use voice_agent/.venv separately from backend/.venv; OpenAI versions conflict.
# One phone worker only; persist the receipt database across restarts.
# Twilio carries the call, Deepgram does the speech.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
# Public HTTPS base URL Twilio can reach, e.g. an ngrok tunnel to port 8001
PUBLIC_BASE_URL=
# Same operator bearer token used by the main backend's phone client.
# Generate separately: openssl rand -hex 32
OPERATOR_TOKEN=
# Main FastAPI backend is authoritative. Frontend runs on 3000.
MAIN_BACKEND_URL=http://127.0.0.1:8000
# Same SURVEY_INGEST_TOKEN as main, sent as X-Survey-Token.
SURVEY_INGEST_TOKEN=
# Optional persistent path. Default: ~/.local/share/walking-on-sunshine/phone_receipts.sqlite3
# PHONE_RECEIPTS_PATH=
# Main issues the canonical patient URL; do NOT copy its signing secret here.
MAX_CALL_SECONDS=600
# Standalone dialer only (create_app(settings, auth) without an integration
# service): it asks main for the signed link over POST /api/voice/patient-link
# using main's SURVEY_INGEST_TOKEN. Leave unset and no link is texted.
GAIT_BACKEND_URL=http://127.0.0.1:8000
GAIT_BACKEND_TOKEN=
# nova-3, or nova-2-phonecall (trained on 8 kHz call audio)
DEEPGRAM_STT_MODEL=nova-3
# Any Aura-2 voice; `python scripts/audition_voices.py` renders samples to compare
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
UTTERANCE_END_MS=1200

# Conversational answer interpretation; without a key, uses exact option matching.
# Set SURVEY_EXTRACTOR=exact for offline operation even when a key is present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SURVEY_EXTRACTOR=exact

# Standalone desktop demo only: optional Postgres/Supabase.
# Integrated phone uses main's patient store; configure its Supabase mode in
# backend/.env after applying the separate integrated patient-store migration.
# Keep service-role / database URLs on the server only.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or voice_web/.
# When both URL and service-role key are set, the voice app stores each
# synthetic patient id, conversation transcript, and survey result.
# CONVERSATION_STORE=in_memory
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
