# Safe runtime defaults
PATIENT_CODE=RGN-0417
PATIENT_REPOSITORY=in_memory
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en

# Phone survey (Twilio carries the call, Deepgram does the speech)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
# Port this server listens on (the WalkingOnSunshine backend defaults to 8000)
PORT=8100
# Public HTTPS base URL Twilio can reach, e.g. an ngrok tunnel to PORT
PUBLIC_BASE_URL=
# Shared secret the dialer page must present to place calls or read transcripts
# (the tunnel exposes those routes publicly). Generate: openssl rand -hex 32
OPERATOR_TOKEN=
# Walking-check magic link texted after the survey. The WalkingOnSunshine backend
# signs it; this server asks for it over POST /api/voice/patient-link using the
# backend's SURVEY_INGEST_TOKEN. Leave unset and no link is texted.
GAIT_BACKEND_URL=http://localhost:8000
GAIT_BACKEND_TOKEN=
# nova-3, or nova-2-phonecall (trained on 8 kHz call audio)
DEEPGRAM_STT_MODEL=nova-3
# Any Aura-2 voice; `python scripts/audition_voices.py` renders samples to compare
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
UTTERANCE_END_MS=1200

# Conversational answer interpretation; without a key, uses exact option matching.
# Set SURVEY_EXTRACTOR=exact for offline operation even when a key is present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SURVEY_EXTRACTOR=openai

# Optional Postgres/Supabase. Keep service-role / database URLs on the server only.
# Never expose SUPABASE_SERVICE_ROLE_KEY to the browser or voice_web/.
# When both URL and service-role key are set, the voice app stores each
# synthetic patient id, conversation transcript, and survey result.
# CONVERSATION_STORE=in_memory
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=
