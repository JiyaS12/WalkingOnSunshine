# Frontend:3000, authoritative main API:8000, separate phone service:8001.
# No operator, service, provider or signing secrets belong in this environment.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: proxy /api/* through Next.js so frontend and backend share an origin
# (needed for the clinician session cookie when they are served from different
# hosts). Set NEXT_PUBLIC_API_URL= (empty) together with this.
# API_PROXY_TARGET=http://localhost:8000
