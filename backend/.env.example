# Required: clinician endpoints fail closed until all three values are set.
CLINICIAN_USERNAME=
CLINICIAN_PASSWORD=
CLINICIAN_SESSION_SECRET=

# Required: signed patient links and voice-survey ingestion fail closed without
# these server-only values. Use different random values for each secret.
PATIENT_LINK_SIGNING_SECRET=
SURVEY_INGEST_TOKEN=
PATIENT_APP_BASE_URL=http://localhost:3000
PATIENT_LINK_TTL_SECONDS=900

# Exact comma-separated frontend origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Explicit local HTTP override. Secure cookies are the application default.
CLINICIAN_COOKIE_SECURE=false
CLINICIAN_SESSION_TTL_SECONDS=28800
CLINICIAN_LOGIN_MAX_ATTEMPTS=5
CLINICIAN_LOGIN_WINDOW_SECONDS=60

# Optional integrations and explicit local/demo escape hatches.
OPENAI_API_KEY=
ALLOW_UNAUTHENTICATED_SURVEY_INGEST=false
ALLOW_DEMO_PATIENTS=false
