# Required: clinician endpoints fail closed until all three values are set.
CLINICIAN_USERNAME=
CLINICIAN_PASSWORD=
CLINICIAN_SESSION_SECRET=

# Required: signed patient links and voice-survey ingestion fail closed without
# these server-only values. Use different random values for each secret.
PATIENT_LINK_SIGNING_SECRET=
SURVEY_INGEST_TOKEN=
PATIENT_APP_BASE_URL=http://localhost:3000
PATIENT_LINK_TTL_SECONDS=900

# Exact comma-separated frontend origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Explicit local HTTP override. Secure cookies are the application default.
CLINICIAN_COOKIE_SECURE=false
CLINICIAN_SESSION_TTL_SECONDS=28800
CLINICIAN_LOGIN_MAX_ATTEMPTS=5
CLINICIAN_LOGIN_WINDOW_SECONDS=60

# Optional integrations and explicit local/demo escape hatches.
OPENAI_API_KEY=
ALLOW_UNAUTHENTICATED_SURVEY_INGEST=false
ALLOW_DEMO_PATIENTS=false

# Optional clinician-to-phone proxy; main startup/tests need no provider credentials.
# Run the independent phone virtualenv on 8001 (main:8000, frontend:3000).
# Keep backend/.venv (openai==3.16.1) separate from voice_agent/.venv (openai<3).
# Use one main worker: patient-store caching and locking are process-local.
PHONE_SERVICE_BASE_URL=http://127.0.0.1:8001
PHONE_SERVICE_TIMEOUT_SECONDS=10
# Same server-only token as the phone service (minimum 16 characters).
OPERATOR_TOKEN=

# Integrated patient storage. Apply supabase/migrations/20260920080000_integrated_patient_records.sql first.
# Set PATIENT_STORE=supabase for the shared patient/survey/walking records.
PATIENT_STORE=json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Explicit demo-only seeding; never copies the local patient cache.
SUPABASE_SEED_DEMO=false
